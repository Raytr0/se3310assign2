digraph {
    fake [style = invisible]
    t0 [root = true, shape = circle]
    fake -> t0 [style = bold]
    node [shape=circle];
    t3 [shape=doublecircle]
    t0 -> t1 [label="a"];
    t0 -> t0 [label="b"];
    t1 -> t1 [label="a"];
    t1 -> t2 [label="b"];

    t2 -> t2 [label="b"];
    t2 -> t3 [label="b"];
}
