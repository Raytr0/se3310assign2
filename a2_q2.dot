digraph NFA {
    fake [style = invisible]
    t0 [root = true, shape = circle]
    fake -> t0 [style = bold]
    t2 [shape=doublecircle]
    t4 [shape=doublecircle]
    node [shape = circle];
    t0 -> t1 [label = "a"];
    t1 -> t2 [label = "b"];
    t2 -> t2 [label = "b"];


    t0 -> t3 [label = "a"];
    t3 -> t4 [label = "b"];
    t4 -> t3 [label = "a"];


}